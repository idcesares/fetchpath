{
  "manifest_version": 3,
  "name": "Fetchpath browser handoff spike",
  "version": "0.1.0",
  "description": "Isolated FP-006 native messaging and fallback proof.",
  "key": "",
  "permissions": [
    "cookies",
    "downloads",
    "nativeMessaging",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
