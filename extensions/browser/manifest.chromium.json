{
  "manifest_version": 3,
  "name": "Fetchpath",
  "version": "0.3.0",
  "description": "Send links, pages and downloads to the Fetchpath download manager.",
  "key": "",
  "permissions": ["contextMenus", "cookies", "nativeMessaging", "storage", "activeTab"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fetchpath",
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/icon-32.png" }
  },
  "icons": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" }
}
