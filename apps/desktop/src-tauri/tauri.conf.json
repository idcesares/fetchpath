{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fetchpath",
  "version": "0.1.0",
  "identifier": "app.fetchpath.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fetchpath",
        "width": 1040,
        "height": 760,
        "minWidth": 600,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Fetchpath contributors",
    "copyright": "Copyright (c) 2026 Fetchpath contributors",
    "license": "MIT OR Apache-2.0",
    "category": "Utility",
    "shortDescription": "Download manager for Windows",
    "longDescription": "Fetchpath queues downloads, verifies what arrived, and recovers safely after a restart.",
    "resources": {
      "THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "tools/user-path.ps1": "tools/user-path.ps1",
      "tools/remove-app-data.ps1": "tools/remove-app-data.ps1",
      "../../../LICENSE-MIT": "LICENSE-MIT.txt",
      "../../../LICENSE-APACHE": "LICENSE-APACHE.txt",
      "../../../docs/user/GUIDE.md": "docs/GUIDE.md",
      "../../../docs/user/CLI.md": "docs/CLI.md",
      "browser/com.fetchpath.browser.chromium.json": "com.fetchpath.browser.chromium.json",
      "browser/com.fetchpath.browser.firefox.json": "com.fetchpath.browser.firefox.json",
      "../../../extensions/browser/manifest.chromium.json": "browser-extension/manifest.json",
      "../../../extensions/browser/background.js": "browser-extension/background.js",
      "../../../extensions/browser/policy.js": "browser-extension/policy.js",
      "../../../extensions/browser/popup.html": "browser-extension/popup.html",
      "../../../extensions/browser/tokens.css": "browser-extension/tokens.css",
      "../../../extensions/browser/popup.css": "browser-extension/popup.css",
      "../../../extensions/browser/popup.js": "browser-extension/popup.js",
      "../../../extensions/browser/icons/icon-32.png": "browser-extension/icons/icon-32.png",
      "../../../extensions/browser/icons/icon-128.png": "browser-extension/icons/icon-128.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tools/sign-windows.ps1",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
